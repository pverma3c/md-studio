{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MD Studio",
  "mainBinaryName": "md-studio",
  "version": "0.1.0",
  "identifier": "com.punit.mdstudio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MD Studio",
        "width": 1360,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: https: http:; media-src 'self' asset: http://asset.localhost https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'",
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "Productivity",
    "shortDescription": "Markdown editor with live preview",
    "icon": [
      "icons/128x128@2x.png",
      "icons/128x128.png",
      "icons/32x32.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown",
        "mimeType": "text/markdown",
        "role": "Editor"
      }
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFDQ0IzREVGNDY3MjFDRkUKUldUK0hISkc3ejNMSEpOdldOWnNMZE5MRjBqYkUxUUp2U3ZPYVU3MFZUbVlobmtXcXdjRHNVNFAK",
      "endpoints": [
        "https://github.com/pverma3c/md-studio/releases/latest/download/latest.json"
      ]
    }
  }
}
