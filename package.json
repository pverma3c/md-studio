{
  "name": "md-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "tauri": "PATH=$HOME/.cargo/bin:$PATH tauri",
    "app:dev": "PATH=$HOME/.cargo/bin:$PATH tauri dev",
    "app:build": "PATH=$HOME/.cargo/bin:$PATH TAURI_SIGNING_PRIVATE_KEY=$HOME/.tauri/md-studio.key TAURI_SIGNING_PRIVATE_KEY_PASSWORD= tauri build --bundles deb",
    "app:deb": "PATH=$HOME/.cargo/bin:$PATH TAURI_SIGNING_PRIVATE_KEY=$HOME/.tauri/md-studio.key TAURI_SIGNING_PRIVATE_KEY_PASSWORD= tauri build --bundles deb",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b --noEmit",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@eslint/js": "^10",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.7.2",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "github-slugger": "^2.0.0",
    "globals": "^17",
    "hast-util-to-string": "^3.0.1",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.52.0",
    "mermaid": "^12.1.0",
    "motion": "^14.0.0",
    "next-themes": "^0.4.6",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "radix-ui": "^1.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.2",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.21.3",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "unist-util-visit": "^5.1.0",
    "vite": "^8",
    "zustand": "^5.0.15"
  },
  "productName": "MD Studio",
  "description": "Markdown editor with live preview, built on Tauri + shadcn/ui.",
  "author": "Punit Verma",
  "dependencies": {
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "@tauri-apps/plugin-window-state": "^2.5.0"
  }
}
